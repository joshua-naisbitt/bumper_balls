; Engine configuration file.
; Bumper Balls - a Mario Party "Bumper Balls" inspired sumo brawler.

config_version=5

[application]

config/name="Bumper Balls"
config/description="Knock your rivals off the dome. Last ball standing wins the round."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

GameConfig="*res://scripts/game_config.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="balls"
3d_physics/layer_2="arena"

[physics]

3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.15, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

